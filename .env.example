# ===== GOOGLE MAPS API CONFIGURATION =====
# Get your FREE API key here: https://console.cloud.google.com/
#
# SETUP STEPS:
# 1. Go to: https://console.cloud.google.com/
# 2. Create a new project (or select existing)
# 3. Navigate to "APIs & Services" → "Library"
# 4. Search for "Maps JavaScript API" and click Enable
# 5. Go to "Credentials" and create an API Key
# 6. Copy the API key and paste it below
# 7. Restart the server (Ctrl+C, then npm start)
#
# Leave empty to use fallback map (still works, just no actual map display)
GOOGLE_EARTH_API_KEY=

# ===== SERVER CONFIGURATION =====
PORT=3000
NODE_ENV=development

# ===== GOOGLE EARTH ENGINE (SERVICE ACCOUNT) =====
# To enable server-side Earth Engine computations, create a service account key
# in the Google Cloud Console and save the JSON file as `private-key.json` in
# the project root (next to server.js). Keep this file private and do not commit
# it to source control. Example filename: `private-key.json`.
