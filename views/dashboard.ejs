<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Foreman Collaboration</title>
    <script src="https://unpkg.com/peerjs@1.5.2/dist/peerjs.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        :root {
            --primary: #667eea;
            --primary-dark: #5568d3;
            --bg-dark: #1a1a2e;
            --bg-darker: #16213e;
            --text-light: #ffffff;
            --text-gray: #a0a0a0;
            --border: #2d3748;
            --success: #27ae60;
            --warning: #f39c12;
            --danger: #e74c3c;
            --foreman: #ffc107;
            --contractor: #17a2b8;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: var(--bg-dark);
            color: var(--text-light);
            height: 100vh;
            overflow: hidden;
        }

        /* Header */
        .header {
            background: var(--bg-darker);
            padding: 12px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .header h1 {
            font-size: 20px;
            color: var(--text-light);
        }

        .user-badge {
            padding: 6px 12px;
            background: var(--primary);
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        .header-right {
            display: flex;
            gap: 10px;
        }

        .btn {
            padding: 8px 16px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s;
        }

        .btn-settings {
            background: var(--primary);
            color: white;
        }

        .btn-settings:hover {
            background: var(--primary-dark);
        }

        .btn-logout {
            background: var(--danger);
            color: white;
        }

        .btn-logout:hover {
            background: #c0392b;
        }

        /* Main Layout */
        .main-container {
            display: flex;
            height: calc(100vh - 60px);
        }

        /* Contacts Sidebar */
        .contacts-sidebar {
            width: 320px;
            background: var(--bg-darker);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
        }

        .contacts-header {
            padding: 15px;
            border-bottom: 1px solid var(--border);
        }

        .contacts-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        .add-contact-btn {
            padding: 8px 12px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: background 0.2s ease;
        }

        .add-contact-btn:hover {
            background: var(--primary-dark);
        }

        .contact-hint {
            font-size: 12px;
            color: var(--text-gray);
        }

        .contacts-header h2 {
            font-size: 16px;
            margin-bottom: 10px;
        }

        .search-box {
            width: 100%;
            padding: 10px;
            background: var(--bg-dark);
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--text-light);
            font-size: 14px;
        }

        .search-box:focus {
            outline: none;
            border-color: var(--primary);
        }

        .contacts-list {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
        }

        .contact-item {
            padding: 12px;
            margin-bottom: 8px;
            background: var(--bg-dark);
            border: 1px solid var(--border);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .contact-item:hover {
            background: #202a3f;
            border-color: var(--primary);
        }

        .contact-item.active {
            background: var(--primary);
            border-color: var(--primary);
        }

        .unread-badge {
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 20px;
            height: 20px;
            padding: 0 6px;
            background: var(--danger);
            color: white;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 700;
            margin-left: auto;
        }

        .contact-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 16px;
        }

        .contact-avatar.foreman {
            background: var(--foreman);
            color: #000;
        }

        .contact-avatar.contractor {
            background: var(--contractor);
        }

        .contact-info {
            flex: 1;
        }

        .contact-name {
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 2px;
        }

        .contact-role {
            font-size: 12px;
            color: var(--text-gray);
        }

        .contact-status {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--success);
        }

        /* Chat Panel */
        .chat-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: var(--bg-dark);
        }

        .chat-header {
            padding: 15px 20px;
            background: var(--bg-darker);
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .chat-user-info {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
        }

        .chat-user-details {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .chat-user-location {
            font-size: 11px;
            color: var(--text-gray);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .profile-btn {
            padding: 6px 12px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            margin-left: 10px;
        }

        .profile-btn:hover {
            background: var(--primary-dark);
        }

        .chat-actions {
            display: flex;
            gap: 10px;
        }

        .action-btn {
            width: 36px;
            height: 36px;
            border: none;
            background: var(--bg-dark);
            color: var(--text-light);
            border-radius: 6px;
            cursor: pointer;
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .action-btn:hover {
            background: var(--primary);
        }

        /* Map Section in Chat */
        .map-section {
            height: 300px;
            border-bottom: 1px solid var(--border);
            position: relative;
        }

        #google-earth-container {
            width: 100%;
            height: 100%;
            background: var(--bg-darker);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #map-loading {
            color: var(--text-gray);
        }

        .map-controls {
            position: absolute;
            bottom: 10px;
            right: 10px;
            display: flex;
            gap: 8px;
        }

        .map-btn {
            padding: 8px 12px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
        }

        .map-btn:hover {
            background: var(--primary-dark);
        }

        /* Call Area */
        .call-area {
            margin: 12px 16px 0 16px;
            padding: 12px;
            background: var(--bg-darker);
            border: 1px solid var(--border);
            border-radius: 10px;
            display: none;
            flex-direction: column;
            gap: 10px;
        }

        .call-status {
            font-size: 13px;
            color: var(--text-gray);
        }

        .call-videos {
            display: flex;
            gap: 10px;
        }

        .call-videos video {
            width: 50%;
            background: #000;
            border-radius: 8px;
            border: 1px solid var(--border);
            max-height: 200px;
        }

        .call-actions {
            display: flex;
            gap: 8px;
        }

        .end-call-btn {
            padding: 8px 12px;
            background: var(--danger);
            color: #fff;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
        }

        .end-call-btn:hover {
            background: #c0392b;
        }

        /* Messages Area */
        .messages-container {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .message {
            max-width: 70%;
            padding: 10px 14px;
            border-radius: 12px;
            word-wrap: break-word;
            line-height: 1.4;
        }

        .message.own {
            align-self: flex-end;
            background: var(--primary);
            color: white;
        }

        .message.other {
            align-self: flex-start;
            background: var(--bg-darker);
            border: 1px solid var(--border);
        }

        .message-meta {
            font-size: 11px;
            opacity: 0.7;
            margin-top: 4px;
        }

        /* Chat Input */
        .chat-input-area {
            padding: 15px 20px;
            background: var(--bg-darker);
            border-top: 1px solid var(--border);
            display: flex;
            gap: 10px;
        }

        #chat-input {
            flex: 1;
            padding: 12px;
            background: var(--bg-dark);
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--text-light);
            font-size: 14px;
        }

        #chat-input:focus {
            outline: none;
            border-color: var(--primary);
        }

        #send-btn {
            padding: 12px 24px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
        }

        #send-btn:hover {
            background: var(--primary-dark);
        }

        /* Empty State */
        .empty-state {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--text-gray);
        }

        .empty-state-icon {
            font-size: 64px;
            margin-bottom: 20px;
        }

        /* Mobile Responsive */
        @media (max-width: 768px) {
            body {
                overflow: auto;
                -webkit-overflow-scrolling: touch;
                touch-action: pan-y pan-x;
            }

            .main-container {
                flex-direction: column;
                height: auto;
                min-height: calc(100vh - 60px);
                overflow: visible;
            }

            .contacts-sidebar {
                width: 100%;
                max-height: 40vh;
                position: relative;
                border-right: none;
                border-bottom: 1px solid var(--border);
                overflow-y: auto;
                -webkit-overflow-scrolling: touch;
            }

            .chat-panel {
                width: 100%;
                min-height: 60vh;
                overflow: visible;
            }

            .map-section {
                height: 250px;
            }

            .messages-container {
                max-height: 50vh;
                overflow-y: auto;
                -webkit-overflow-scrolling: touch;
            }

            .message {
                max-width: 85%;
            }

            .contacts-list {
                -webkit-overflow-scrolling: touch;
            }
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg-darker);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--primary);
        }

        /* Profile Modal */
        .profile-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.7);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .profile-modal.active {
            display: flex;
        }

        .profile-content {
            background: var(--bg-darker);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 30px;
            max-width: 500px;
            width: 90%;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
        }

        .profile-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 25px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border);
        }

        .profile-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            font-weight: bold;
        }

        .profile-avatar.foreman {
            background: var(--foreman);
            color: #000;
        }

        .profile-avatar.contractor {
            background: var(--contractor);
        }

        .profile-title h2 {
            font-size: 24px;
            margin-bottom: 5px;
        }

        .profile-title p {
            color: var(--text-gray);
            font-size: 14px;
        }

        .profile-info {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .profile-field {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            background: var(--bg-dark);
            border-radius: 8px;
        }

        .profile-field-icon {
            font-size: 20px;
            width: 30px;
            text-align: center;
        }

        .profile-field-content {
            flex: 1;
        }

        .profile-field-label {
            font-size: 11px;
            color: var(--text-gray);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 2px;
        }

        .profile-field-value {
            font-size: 14px;
            color: var(--text-light);
            font-weight: 600;
        }

        .profile-actions {
            margin-top: 25px;
            display: flex;
            gap: 10px;
        }

        .profile-close-btn {
            flex: 1;
            padding: 12px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
        }

        .profile-close-btn:hover {
            background: var(--primary-dark);
        }

        /* Review Bar */
        .review-bar-section {
            margin-top: 20px;
            border-top: 1px solid var(--border);
            padding-top: 18px;
        }

        .review-bar-section h3 {
            font-size: 15px;
            margin-bottom: 12px;
            color: var(--text-light);
        }

        .review-summary {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
        }

        .review-avg-score {
            font-size: 36px;
            font-weight: 700;
            color: var(--foreman);
            line-height: 1;
        }

        .review-stars {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .stars {
            display: flex;
            gap: 2px;
            font-size: 18px;
        }

        .star { cursor: default; }
        .star.filled { color: var(--foreman); }
        .star.empty  { color: var(--border); }

        .review-total {
            font-size: 12px;
            color: var(--text-gray);
        }

        .reviews-list {
            max-height: 160px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 14px;
        }

        .review-item {
            padding: 10px;
            background: var(--bg-dark);
            border-radius: 8px;
            font-size: 13px;
        }

        .review-item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 4px;
        }

        .review-item-name {
            font-weight: 600;
            font-size: 13px;
        }

        .review-item-stars { font-size: 14px; }
        .review-item-comment { color: var(--text-gray); font-size: 12px; }
        .review-item-date { font-size: 11px; color: var(--text-gray); margin-top: 4px; }

        .review-form {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .review-form-label {
            font-size: 13px;
            color: var(--text-gray);
        }

        .star-picker {
            display: flex;
            gap: 6px;
        }

        .star-pick {
            font-size: 24px;
            cursor: pointer;
            color: var(--border);
            transition: color 0.15s;
            line-height: 1;
        }

        .star-pick.selected,
        .star-pick:hover,
        .star-pick.hover { color: var(--foreman); }

        .review-comment-input {
            width: 100%;
            padding: 8px 10px;
            background: var(--bg-dark);
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--text-light);
            font-size: 13px;
            resize: none;
            font-family: inherit;
        }

        .review-comment-input:focus {
            outline: none;
            border-color: var(--primary);
        }

        .submit-review-btn {
            align-self: flex-end;
            padding: 8px 18px;
            background: var(--foreman);
            color: #000;
            border: none;
            border-radius: 6px;
            font-weight: 700;
            cursor: pointer;
            font-size: 13px;
            transition: opacity 0.2s;
        }

        .submit-review-btn:hover { opacity: 0.85; }
        .review-msg { font-size: 12px; color: var(--success); }
    </style>
</head>
<body>
    <!-- Header -->
    <div class="header">
        <div class="header-left">
            <h1>🏗️ Foreman Collaboration</h1>
            <span class="user-badge"><%= user.username %> • <%= user.category %></span>
        </div>
        <div class="header-right">
            <a href="/settings?session=<%= sessionId %>" class="btn btn-settings">⚙️ Settings</a>
            <a href="/logout?session=<%= sessionId %>" class="btn btn-logout">Logout</a>
        </div>
    </div>

    <!-- Main Container -->
    <div class="main-container">
        <!-- Contacts Sidebar -->
        <div class="contacts-sidebar">
            <div class="contacts-header">
                <h2>📞 Contacts (<span id="user-count">0</span>)</h2>
                <div class="contacts-actions">
                    <button class="add-contact-btn" id="add-contact-btn">+ Add Contact</button>
                    <span class="contact-hint">All registered users appear below.</span>
                </div>
                <input type="text" class="search-box" id="search-contacts" placeholder="Search contacts...">
            </div>
            <div class="contacts-list" id="contacts-list">
                <div class="empty-state">
                    <div class="empty-state-icon">👥</div>
                    <p>No contacts online yet</p>
                </div>
            </div>
        </div>

        <!-- Chat Panel with Embedded Map -->
        <div class="chat-panel">
            <div class="chat-header">
                <div class="chat-user-info">
                    <div class="contact-avatar" id="chat-avatar">?</div>
                    <div class="chat-user-details">
                        <div class="contact-name" id="chat-contact-name">Select a contact</div>
                        <div class="contact-role" id="chat-contact-role">to start chatting</div>
                        <div class="chat-user-location" id="chat-user-location" style="display: none;">
                            <span>📍</span>
                            <span id="chat-user-location-text"></span>
                        </div>
                    </div>
                    <button class="profile-btn" id="view-profile-btn" style="display: none;">View Profile</button>
                </div>
                <div class="chat-actions">
                    <button class="action-btn" id="call-btn" title="Voice Call">📞</button>
                    <button class="action-btn" id="video-btn" title="Video Call">📹</button>
                    <button class="action-btn" id="toggle-map-btn" title="Toggle Map">🗺️</button>
                </div>
            </div>

            <!-- Google Earth Map Section -->
            <div class="map-section" id="map-section" style="display: none;">
                <div id="google-earth-container">
                    <p id="map-loading">Loading Google Earth...</p>
                </div>
                <div class="map-controls">
                    <button class="map-btn" id="drop-pin-btn">📍 Drop Pin</button>
                    <button class="map-btn" id="share-location-btn">📡 Share Location</button>
                </div>
            </div>

            <!-- Call Area -->
            <div class="call-area" id="call-area">
                <div class="call-status" id="call-status">Connecting...</div>
                <div class="call-videos">
                    <video id="local-video" autoplay muted playsinline></video>
                    <video id="remote-video" autoplay playsinline></video>
                </div>
                <div class="call-actions">
                    <button class="end-call-btn" id="end-call-btn">Hang Up</button>
                </div>
            </div>

            <!-- Messages -->
            <div class="messages-container" id="messages-container">
                <div class="empty-state">
                    <div class="empty-state-icon">💬</div>
                    <p>Select a contact from the left to start chatting</p>
                </div>
            </div>

            <!-- Chat Input -->
            <div class="chat-input-area">
                <input type="text" id="chat-input" placeholder="Select a contact to chat..." disabled />
                <input type="file" id="media-input" accept="image/*,video/*" style="display: none;" />
                <button id="location-share-btn" title="Share Location in Chat" style="padding: 12px 16px; background: var(--success); color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 16px;" disabled>📍</button>
                <button id="media-btn" title="Share Image/Video" style="padding: 12px 16px; background: var(--primary); color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 16px;" disabled>📎</button>
                <button id="send-btn" disabled>Send</button>
            </div>
        </div>
    </div>

    <!-- Profile Modal -->
    <div class="profile-modal" id="profile-modal">
        <div class="profile-content">
            <div class="profile-header">
                <div class="profile-avatar" id="profile-avatar">?</div>
                <div class="profile-title">
                    <h2 id="profile-username">Username</h2>
                    <p id="profile-category">Role</p>
                </div>
            </div>
            <div class="profile-info">
                <div class="profile-field">
                    <div class="profile-field-icon">📧</div>
                    <div class="profile-field-content">
                        <div class="profile-field-label">Email</div>
                        <div class="profile-field-value" id="profile-email">Not available</div>
                    </div>
                </div>
                <div class="profile-field">
                    <div class="profile-field-icon">📱</div>
                    <div class="profile-field-content">
                        <div class="profile-field-label">Phone</div>
                        <div class="profile-field-value" id="profile-phone">Not available</div>
                    </div>
                </div>
                <div class="profile-field" id="profile-location-field" style="display: none;">
                    <div class="profile-field-icon">📍</div>
                    <div class="profile-field-content">
                        <div class="profile-field-label">Location</div>
                        <div class="profile-field-value" id="profile-location">Not available</div>
                    </div>
                </div>
                <div class="profile-field" id="profile-bio-field" style="display: none;">
                    <div class="profile-field-icon">📝</div>
                    <div class="profile-field-content">
                        <div class="profile-field-label">Bio</div>
                        <div class="profile-field-value" id="profile-bio" style="white-space: pre-wrap;">Not available</div>
                    </div>
                </div>
                <div class="profile-field">
                    <div class="profile-field-icon">🕒</div>
                    <div class="profile-field-content">
                        <div class="profile-field-label">Joined</div>
                        <div class="profile-field-value" id="profile-joined">Not available</div>
                    </div>
                </div>
            </div>
            <div class="profile-actions">
                <button class="profile-close-btn" id="profile-close-btn">Close</button>
            </div>

            <!-- Review Bar (shown only for foremen) -->
            <div class="review-bar-section" id="review-bar-section" style="display:none;">
                <h3>⭐ Reviews</h3>

                <!-- Summary -->
                <div class="review-summary">
                    <div class="review-avg-score" id="review-avg-score">—</div>
                    <div class="review-stars">
                        <div class="stars" id="review-avg-stars"></div>
                        <div class="review-total" id="review-total">No reviews yet</div>
                    </div>
                </div>

                <!-- Existing reviews -->
                <div class="reviews-list" id="reviews-list"></div>

                <!-- Submit review form -->
                <div class="review-form" id="review-form">
                    <div class="review-form-label">Leave a review:</div>
                    <div class="star-picker" id="star-picker">
                        <span class="star-pick" data-value="1">★</span>
                        <span class="star-pick" data-value="2">★</span>
                        <span class="star-pick" data-value="3">★</span>
                        <span class="star-pick" data-value="4">★</span>
                        <span class="star-pick" data-value="5">★</span>
                    </div>
                    <textarea class="review-comment-input" id="review-comment" rows="2" placeholder="Optional comment..."></textarea>
                    <button class="submit-review-btn" id="submit-review-btn">Submit Review</button>
                    <div class="review-msg" id="review-msg" style="display:none;"></div>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        // Media button click handler
        document.getElementById('media-btn')?.addEventListener('click', () => {
            document.getElementById('media-input')?.click();
        });
    </script>

    <script>
        // ---- Review Bar Logic ----
        let reviewForemanId = null;
        let selectedRating = 0;

        function renderStars(rating, container, size = 18) {
            container.innerHTML = '';
            for (let i = 1; i <= 5; i++) {
                const s = document.createElement('span');
                s.className = 'star ' + (i <= Math.round(rating) ? 'filled' : 'empty');
                s.textContent = '★';
                s.style.fontSize = size + 'px';
                container.appendChild(s);
            }
        }

        async function loadReviews(foremanId) {
            try {
                const res = await fetch(`/api/reviews/${foremanId}`);
                const data = await res.json();
                const avgEl = document.getElementById('review-avg-score');
                const avgStarsEl = document.getElementById('review-avg-stars');
                const totalEl = document.getElementById('review-total');
                const listEl = document.getElementById('reviews-list');

                avgEl.textContent = data.averageRating ? data.averageRating : '—';
                if (data.averageRating) renderStars(parseFloat(data.averageRating), avgStarsEl);
                else avgStarsEl.innerHTML = '';
                totalEl.textContent = data.total === 0
                    ? 'No reviews yet'
                    : `${data.total} review${data.total > 1 ? 's' : ''}`;

                listEl.innerHTML = '';
                if (data.reviews.length === 0) {
                    listEl.innerHTML = '<div style="color:var(--text-gray);font-size:13px;">Be the first to leave a review!</div>';
                } else {
                    data.reviews.slice().reverse().forEach(r => {
                        const d = document.createElement('div');
                        d.className = 'review-item';
                        const stars = '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating);
                        const date = new Date(r.timestamp).toLocaleDateString();
                        d.innerHTML = `
                            <div class="review-item-header">
                                <span class="review-item-name">${escapeHtml(r.reviewerName)}</span>
                                <span class="review-item-stars" style="color:var(--foreman)">${stars}</span>
                            </div>
                            ${r.comment ? `<div class="review-item-comment">${escapeHtml(r.comment)}</div>` : ''}
                            <div class="review-item-date">${date}</div>`;
                        listEl.appendChild(d);
                    });
                }
            } catch (e) {
                console.error('Failed to load reviews', e);
            }
        }

        function escapeHtml(str) {
            return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        // Star picker interaction
        const starPicker = document.getElementById('star-picker');
        starPicker?.querySelectorAll('.star-pick').forEach(star => {
            star.addEventListener('mouseover', () => {
                const v = parseInt(star.dataset.value);
                starPicker.querySelectorAll('.star-pick').forEach(s =>
                    s.classList.toggle('hover', parseInt(s.dataset.value) <= v));
            });
            star.addEventListener('mouseout', () => {
                starPicker.querySelectorAll('.star-pick').forEach(s => s.classList.remove('hover'));
            });
            star.addEventListener('click', () => {
                selectedRating = parseInt(star.dataset.value);
                starPicker.querySelectorAll('.star-pick').forEach(s =>
                    s.classList.toggle('selected', parseInt(s.dataset.value) <= selectedRating));
            });
        });

        document.getElementById('submit-review-btn')?.addEventListener('click', async () => {
            const msgEl = document.getElementById('review-msg');
            if (!selectedRating) { msgEl.style.display = 'block'; msgEl.style.color = 'var(--danger)'; msgEl.textContent = 'Please select a star rating.'; return; }
            const comment = document.getElementById('review-comment').value.trim();
            try {
                const res = await fetch('/api/reviews', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ foremanId: reviewForemanId, rating: selectedRating, comment, sessionId })
                });
                const data = await res.json();
                if (res.ok) {
                    msgEl.style.display = 'block'; msgEl.style.color = 'var(--success)'; msgEl.textContent = '✓ Review submitted!';
                    document.getElementById('review-comment').value = '';
                    selectedRating = 0;
                    starPicker.querySelectorAll('.star-pick').forEach(s => s.classList.remove('selected'));
                    loadReviews(reviewForemanId);
                    setTimeout(() => { msgEl.style.display = 'none'; }, 3000);
                } else {
                    msgEl.style.display = 'block'; msgEl.style.color = 'var(--danger)'; msgEl.textContent = data.error || 'Failed to submit review.';
                }
            } catch (e) {
                msgEl.style.display = 'block'; msgEl.style.color = 'var(--danger)'; msgEl.textContent = 'Network error. Try again.';
            }
        });

        // Expose a function main.js can call when opening a profile
        window.openReviewBar = function(foremanId, isForeman) {
            const section = document.getElementById('review-bar-section');
            const form = document.getElementById('review-form');
            if (!section) return;
            if (!isForeman) { section.style.display = 'none'; return; }
            section.style.display = 'block';
            reviewForemanId = foremanId;
            selectedRating = 0;
            starPicker.querySelectorAll('.star-pick').forEach(s => s.classList.remove('selected'));
            document.getElementById('review-comment').value = '';
            document.getElementById('review-msg').style.display = 'none';
            // Hide form if viewing own profile
            form.style.display = (foremanId === user.dbId) ? 'none' : 'flex';
            loadReviews(foremanId);
        };
    </script>
    
    <script>
        // Bootstrap data so the contacts list renders instantly
        window.__BOOTSTRAP_USERS__ = <%- JSON.stringify(allUsers || []) %>;
        const sessionId = '<%= sessionId %>';
        const user = {
            username: '<%= user.username %>',
            category: '<%= user.category %>',
            dbId: '<%= user.id %>'
        };
        const googleEarthApiKey = '<%= googleEarthApiKey %>';
    </script>
    <script src="https://maps.googleapis.com/maps/api/js?key=<%= googleEarthApiKey || 'AIzaSyDummy' %>&callback=initMap" async defer></script>
    <script src="/js/main.js?v=<%= Date.now() %>"></script>
</body>
</html>
