    <script>
        // ---- Review Bar Logic ----
        let reviewForemanId = null;
        let selectedRating = 0;

        function renderStars(rating, container, size = 18) {
            container.innerHTML = '';
            for (let i = 1; i <= 5; i++) {
                const s = document.createElement('span');
                s.className = 'star ' + (i <= Math.round(rating) ? 'filled' : 'empty');
                s.textContent = '★';
                s.style.fontSize = size + 'px';
                container.appendChild(s);
            }
        }

        async function loadReviews(foremanId) {
            try {
                const res = await fetch(`/api/reviews/${foremanId}`);
                const data = await res.json();
                const avgEl = document.getElementById('review-avg-score');
                const avgStarsEl = document.getElementById('review-avg-stars');
                const totalEl = document.getElementById('review-total');
                const listEl = document.getElementById('reviews-list');

                avgEl.textContent = data.averageRating ? data.averageRating : '—';
                if (data.averageRating) renderStars(parseFloat(data.averageRating), avgStarsEl);
                else avgStarsEl.innerHTML = '';
                totalEl.textContent = data.total === 0
                    ? 'No reviews yet'
                    : `${data.total} review${data.total > 1 ? 's' : ''}`;

                listEl.innerHTML = '';
                if (data.reviews.length === 0) {
                    listEl.innerHTML = '<div style="color:var(--text-gray);font-size:13px;">Be the first to leave a review!</div>';
                } else {
                    data.reviews.slice().reverse().forEach(r => {
                        const d = document.createElement('div');
                        d.className = 'review-item';
                        const stars = '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating);
                        const date = new Date(r.timestamp).toLocaleDateString();
                        d.innerHTML = `
                            <div class="review-item-header">
                                <span class="review-item-name">${escapeHtml(r.reviewerName)}</span>
                                <span class="review-item-stars" style="color:var(--foreman)">${stars}</span>
                            </div>
                            ${r.comment ? `<div class="review-item-comment">${escapeHtml(r.comment)}</div>` : ''}
                            <div class="review-item-date">${date}</div>`;
                        listEl.appendChild(d);
                    });
                }
            } catch (e) {
                console.error('Failed to load reviews', e);
            }
        }

        function escapeHtml(str) {
            return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        // Star picker interaction
        const starPicker = document.getElementById('star-picker');
        starPicker?.querySelectorAll('.star-pick').forEach(star => {
            star.addEventListener('mouseover', () => {
                const v = parseInt(star.dataset.value);
                starPicker.querySelectorAll('.star-pick').forEach(s =>
                    s.classList.toggle('hover', parseInt(s.dataset.value) <= v));
            });
            star.addEventListener('mouseout', () => {
                starPicker.querySelectorAll('.star-pick').forEach(s => s.classList.remove('hover'));
            });
            star.addEventListener('click', () => {
                selectedRating = parseInt(star.dataset.value);
                starPicker.querySelectorAll('.star-pick').forEach(s =>
                    s.classList.toggle('selected', parseInt(s.dataset.value) <= selectedRating));
            });
        });

        document.getElementById('submit-review-btn')?.addEventListener('click', async () => {
            const msgEl = document.getElementById('review-msg');
            if (!selectedRating) { msgEl.style.display = 'block'; msgEl.style.color = 'var(--danger)'; msgEl.textContent = 'Please select a star rating.'; return; }
            const comment = document.getElementById('review-comment').value.trim();
            try {
                const res = await fetch('/api/reviews', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ foremanId: reviewForemanId, rating: selectedRating, comment, sessionId })
                });
                const data = await res.json();
                if (res.ok) {
                    msgEl.style.display = 'block'; msgEl.style.color = 'var(--success)'; msgEl.textContent = '✓ Review submitted!';
                    document.getElementById('review-comment').value = '';
                    selectedRating = 0;
                    starPicker.querySelectorAll('.star-pick').forEach(s => s.classList.remove('selected'));
                    loadReviews(reviewForemanId);
                    setTimeout(() => { msgEl.style.display = 'none'; }, 3000);
                } else {
                    msgEl.style.display = 'block'; msgEl.style.color = 'var(--danger)'; msgEl.textContent = data.error || 'Failed to submit review.';
                }
            } catch (e) {
                msgEl.style.display = 'block'; msgEl.style.color = 'var(--danger)'; msgEl.textContent = 'Network error. Try again.';
            }
        });

        // Expose a function main.js can call when opening a profile
        window.openReviewBar = function(foremanId, isForeman) {
            const section = document.getElementById('review-bar-section');
            const form = document.getElementById('review-form');
            if (!section) return;
            if (!isForeman) { section.style.display = 'none'; return; }
            section.style.display = 'block';
            reviewForemanId = foremanId;
            selectedRating = 0;
            starPicker.querySelectorAll('.star-pick').forEach(s => s.classList.remove('selected'));
            document.getElementById('review-comment').value = '';
            document.getElementById('review-msg').style.display = 'none';
            // Hide form if viewing own profile
            form.style.display = (foremanId === user.dbId) ? 'none' : 'flex';
            loadReviews(foremanId);
        };
    </script>
    
