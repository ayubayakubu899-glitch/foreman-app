            category: '<%= user.category %>',
            dbId: '<%= user.id %>',
            location: '<%= user.location || "" %>',
            isAvailableForJob: <%= user.isAvailableForJob ? 'true' : 'false' %>,
            needsForeman: <%= user.needsForeman ? 'true' : 'false' %>
