<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - Foreman Collaboration</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            color: #fff;
        }
        .card {
            width: 100%;
            max-width: 430px;
            background: rgba(20, 20, 25, 0.95);
            border: 1px solid #333;
            border-radius: 14px;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
        }
        h1 { font-size: 24px; margin-bottom: 8px; text-align: center; }
        .subtitle { color: #b0b0b0; font-size: 13px; margin-bottom: 20px; text-align: center; }
        .alert {
            margin-bottom: 14px;
            padding: 10px;
            border-radius: 8px;
            font-size: 13px;
            background: rgba(102, 126, 234, 0.12);
            border: 1px solid rgba(102, 126, 234, 0.3);
            color: #dbe3ff;
        }
        label { display: block; margin-bottom: 6px; font-size: 12px; color: #c9c9c9; text-transform: uppercase; }
        input {
            width: 100%;
            padding: 12px;
            border: 1px solid #333;
            border-radius: 8px;
            background: #1a1a1e;
            color: #fff;
            margin-bottom: 14px;
        }
        input:focus { outline: none; border-color: #667eea; }
        button {
            width: 100%;
            border: none;
            border-radius: 8px;
            padding: 12px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            font-weight: 700;
            cursor: pointer;
        }
        .reset-link-box {
            margin-top: 14px;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid rgba(39, 174, 96, 0.4);
            background: rgba(39, 174, 96, 0.12);
            font-size: 13px;
            word-break: break-all;
        }
        .reset-link-box a { color: #7dd8a9; }
        .links {
            margin-top: 16px;
            text-align: center;
            font-size: 13px;
        }
        .links a { color: #8aa0ff; text-decoration: none; }
    </style>
</head>
<body>
    <div class="card">
        <h1>Reset Password</h1>
        <p class="subtitle">Enter your email to generate a password reset link.</p>

        <% if (message) { %>
            <div class="alert"><%= message %></div>
        <% } %>

        <form action="/forgot-password" method="POST">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" required placeholder="your@email.com">
            <button type="submit">Generate Reset Link</button>
        </form>

        <% if (resetLink) { %>
            <div class="reset-link-box">
                <strong>Reset link:</strong><br>
                <a href="<%= resetLink %>"><%= resetLink %></a>
            </div>
        <% } %>

        <div class="links">
            <a href="/login">Back to Login</a>
        </div>
    </div>
</body>
</html>
