<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - Foreman Collaboration</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            overflow-x: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .page-wrapper {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 450px;
        }

        .form-container {
            background: rgba(20, 20, 25, 0.95);
            border: 1px solid #333;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(10px);
        }

        .form-container h1 {
            color: #fff;
            font-size: 28px;
            margin-bottom: 10px;
            text-align: center;
        }

        .form-subtitle {
            color: #aaa;
            font-size: 14px;
            text-align: center;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            color: #ddd;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 12px 14px;
            background: #1a1a1e;
            border: 1px solid #333;
            border-radius: 8px;
            color: #fff;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .form-group input::placeholder {
            color: #666;
        }

        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            background: #222227;
        }

        .form-group select {
            cursor: pointer;
        }

        .btn {
            width: 100%;
            padding: 13px;
            margin-top: 10px;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
        }

        .form-links {
            margin-top: 25px;
            text-align: center;
        }

        .form-links p {
            color: #888;
            font-size: 13px;
            margin-bottom: 10px;
        }

        .form-links a {
            color: #667eea;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s ease;
        }

        .form-links a:hover {
            color: #764ba2;
            text-decoration: underline;
        }

        /* Responsive */
        @media (max-width: 600px) {
            body {
                padding: 15px;
            }

            .form-container {
                padding: 30px 20px;
            }

            .form-container h1 {
                font-size: 24px;
            }

            .btn {
                padding: 12px;
                font-size: 15px;
            }
        }
    </style>
</head>
<body>
    <div class="page-wrapper">
        <div class="form-container">
            <h1>🏗️ Create Account</h1>
            <p class="form-subtitle">Join the foreman collaboration platform</p>
            
            <form action="/signup" method="POST" id="signup-form">
                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" name="username" required minlength="3" maxlength="20" placeholder="Choose a username (3-20 characters)">
                </div>

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" required placeholder="your@email.com">
                </div>

                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input type="tel" id="phone" name="phone" required placeholder="+1 (555) 000-0000" pattern="[0-9\-\+\(\)\s]{10,}">
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" required minlength="6" placeholder="At least 6 characters">
                </div>

                <div class="form-group">
                    <label for="confirm-password">Confirm Password</label>
                    <input type="password" id="confirm-password" name="confirm-password" required minlength="6" placeholder="Re-enter your password">
                </div>

                <div class="form-group">
                    <label for="category">Role</label>
                    <select id="category" name="category" required>
                        <option value="">Select your role</option>
                        <option value="foreman">👷 Foreman</option>
                        <option value="contractor">🏗️ Contractor</option>
                    </select>
                </div>

                <div class="form-group" id="location-group">
                    <label for="location">Location <span style="color: #e74c3c;">*</span></label>
                    <input type="text" id="location" name="location" required placeholder="City, State or Region (required)">
                </div>

                <button type="submit" class="btn btn-primary">Sign Up</button>
            </form>

            <div class="form-links">
                <p>Already have an account? <a href="/login">Login here</a></p>
                <p><a href="/">← Back to Home</a></p>
            </div>
        </div>
    </div>

    <script>
        const categorySelect = document.getElementById('category');
        const locationGroup = document.getElementById('location-group');
        const locationInput = document.getElementById('location');

        // Location is required for both roles
        categorySelect.addEventListener('change', function() {
            locationGroup.style.display = 'block';
            locationInput.required = true;
        });

        document.getElementById('signup-form').addEventListener('submit', function(e) {
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirm-password').value;
            const category = categorySelect.value;
            const location = locationInput.value.trim();

            if (password !== confirmPassword) {
                e.preventDefault();
                alert('❌ Passwords do not match!');
                return false;
            }

            if (password.length < 6) {
                e.preventDefault();
                alert('❌ Password must be at least 6 characters long!');
                return false;
            }

            if (!location) {
                e.preventDefault();
                alert('❌ Location is required for all users!');
                return false;
            }
        });
    </script>
</body>
</html>
